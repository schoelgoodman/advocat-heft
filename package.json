{
  "name": "advocat-heft",
  "private": true,
  "type": "module",
  "description": "Setzer und Redaktion für Advocat Finanz. Markdown liegt ausserhalb dieses Repos.",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "import": "node scripts/import-wordpress.ts",
    "render": "node src/cli/render.ts",
    "build": "node src/cli/build.ts",
    "editor:build": "vite build",
    "dev": "node src/server/index.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:browser": "node tests/browser/redaktion.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@milkdown/crepe": "^7.18.0",
    "chokidar": "^4.0.3",
    "happy-dom": "^21.0.4",
    "mammoth": "^1.13.0",
    "sharp": "^0.35.5",
    "simple-git": "^4.0.2",
    "vite": "^7.1.12",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.3"
  }
}
